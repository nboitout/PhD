# Copy to .env.local for local development — never commit .env.local

# Admin dashboard (/admin) — shared password gate
ADMIN_PASSWORD=

# Visitor analytics — write path (Google Apps Script web app bound to the sheet)
# The /exec URL of the deployment. Open it once in a browser: it must answer
# {"ok":true,...} and not a "needs your permission" page, or writes fail silently.
APPS_SCRIPT_URL=

# Visitor analytics — read path (service account, Sheets API v4)
# GOOGLE_SHEETS_ID is the long id in the sheet's URL (a full URL also works).
# The sheet is "PhD Website Visits":
#   https://docs.google.com/spreadsheets/d/1j_-YidhHUSZbg4Bd0FYbVsNIrfzajRwhd_Uy722FsFA/edit
# Share the sheet with GOOGLE_SERVICE_ACCOUNT_EMAIL as a Viewer, using the full
# ...@<project>.iam.gserviceaccount.com address, or the dashboard gets a 403.
GOOGLE_SHEETS_ID=1j_-YidhHUSZbg4Bd0FYbVsNIrfzajRwhd_Uy722FsFA
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# base64 of the whole private_key value from the service account's JSON key.
# Use the base64 form: a raw PEM in an env var gets its newlines mangled.
#   node -e "console.log(Buffer.from(require('./key.json').private_key).toString('base64'))"
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY_BASE64=
# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=          # or the raw PEM (fragile; code normalizes it)

# Optional exclusions (comma-separated reader_id cookie values to hide from analytics)
EXCLUDED_READER_IDS=
